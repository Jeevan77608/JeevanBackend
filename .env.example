# =============================================================================
# Feature Toggles
# =============================================================================
# Disable authentication for local development (no Azure AD required)
AUTH_ENABLED=false
# Disable Redis to use in-memory session storage (local development only)
REDIS_ENABLED=false

# =============================================================================
# Identity provider configuration (recommended: Supabase Auth)
# =============================================================================
AUTH_PROVIDER=supabase
# Azure AD / Entra ID Configuration (required when AUTH_PROVIDER=azure_ad)
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_REDIRECT_URI=http://localhost:8000/auth/callback
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=user-context-files
SUPABASE_STORAGE_ENABLED=false
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3000/api/jira/callback
JIRA_SITE_URL=https://your-site.atlassian.net

# =============================================================================
# Azure OpenAI Configuration
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4-turbo
AZURE_OPENAI_API_VERSION=2024-02-01

# =============================================================================
# Redis Configuration (required when REDIS_ENABLED=true)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# =============================================================================
# Security Settings
# =============================================================================
# Encryption Key (32 bytes base64 encoded for AES-256)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=
APP_SECRET_KEY=replace-with-a-random-string-at-least-32-characters
# Shared with the frontend's server-side INTERNAL_API_KEY setting.
INTERNAL_API_KEY=

# =============================================================================
# Azure DevOps Configuration
# =============================================================================
AZURE_DEVOPS_DEFAULT_ORG_URL=https://dev.azure.com/YourOrg
AZURE_DEVOPS_DEFAULT_PROJECT=YourProject
AZURE_DEVOPS_WIKI_IDENTIFIER=YourProject.wiki
# Personal Access Token (PAT) - used when AUTH_ENABLED=false
AZURE_DEVOPS_PAT=your-personal-access-token

# =============================================================================
# Application Settings
# =============================================================================
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=your-super-secret-key-for-sessions
LOG_LEVEL=INFO

# =============================================================================
# Session Settings
# =============================================================================
SESSION_EXPIRY_HOURS=24

# =============================================================================
# Push Settings
# =============================================================================
# Default tag injected on every push to Azure DevOps (leave empty to disable)
DEFAULT_PUSH_TAG=@AIGenerated
# =============================================================================
# Chat conversation history (Cosmos DB) - optional
# =============================================================================
# Set to true to enable save/list/load of chat conversations (hamburger sidebar)
CHAT_SAVE_ENABLED=false
# Days to keep saved conversations (Cosmos TTL); 1-365
CHAT_RETENTION_DAYS=15
# Days of conversation history to show in sidebar (1-365); older chats are hidden but not deleted
CHAT_HISTORY_DISPLAY_DAYS=15
# Restrict chat to Epic/Task generation only; show boundary message for off-topic requests
CHAT_SCOPE_STRICT=true
# Message shown when user message is out of scope (epic/task only)
# CHAT_SCOPE_BOUNDARY_MESSAGE=This chat is for Epic and Task generation...
# Max messages (including system) sent to LLM; 2-100 (limits context to reduce hallucination)
CHAT_CONTEXT_WINDOW_MESSAGES=20
# Max history messages (user+assistant) to include per request; 1-50
CHAT_HISTORY_LIMIT_MESSAGES=10
# Azure Cosmos DB (create account in Azure Portal; see docs/COSMOS_SETUP.md)
# Endpoint: Azure Portal → your Cosmos DB account → Keys → URI
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
# Key: Azure Portal → Cosmos DB account → Keys → Primary Key
COSMOS_KEY=your-cosmos-primary-key
# Set to true if your Cosmos DB account is serverless (omit for provisioned throughput)
COSMOS_SERVERLESS=true
# Optional; defaults: mcp, conversations
# COSMOS_DATABASE_ID=mcp
# COSMOS_CONTAINER_ID=conversations
